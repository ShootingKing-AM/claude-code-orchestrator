# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required for GitHub Copilot backend
# Get a token at: https://github.com/settings/tokens
# Needs no special scopes — your Copilot subscription is tied to the account.
GITHUB_TOKEN=

# Optional: override the default model used for Copilot jobs
# Run: gh copilot suggest 'list models' or check api.githubcopilot.com/models
# COPILOT_MODEL=claude-sonnet-4.6

# Optional: explicit OAuth token for Copilot API (gho_... not ghp_...)
# If unset, auto-detected from `gh auth status --show-token`
# COPILOT_TOKEN=gho_...

# Optional: change the server port (default 7842)
# PORT=7842
